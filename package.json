{
  "name": "book-front",
  "version": "0.0.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:qa": "ng build --configuration=qa",
    "build:native:qa": "ng build --configuration=qa && cap sync android && node scripts/android/stamp-native-build.mjs qa",
    "build:native:production": "ng build --configuration=production && cap sync android && node scripts/android/stamp-native-build.mjs production",
    "native:sync": "cap sync android",
    "native:open": "cap open android",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage --no-progress",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:typecheck": "tsc --project tsconfig.e2e.json",
    "e2e:smoke": "playwright test --grep @smoke --project=chromium --project=firefox --project=webkit",
    "e2e:responsive": "playwright test e2e/responsive.matrix.spec.ts",
    "e2e:visual": "playwright test --grep @visual --project=chromium",
    "api:lint": "redocly lint --extends=minimal docs/backend/openapi.yaml",
    "qa:control:test": "node --test scripts/qa/*.test.mjs",
    "qa:android-browser": "node scripts/qa/android-browser-smoke.mjs",
    "qa:ci": "npm run api:lint && npm run qa:control:test && npm run build && npm run test:ci && npm run e2e:typecheck && playwright test --project=chromium --grep @smoke",
    "qa:browsers": "npm run e2e:smoke && npm run e2e:responsive && npm run e2e:visual",
    "qa:integration": "playwright test --config=playwright.integration.config.ts --grep @integration",
    "qa:visual": "playwright test --project=chromium --grep @visual",
    "qa:rtf:fixtures": "node scripts/qa/rtf-interop/run.mjs --fixtures",
    "qa:rtf:corpus": "node scripts/qa/rtf-interop/run.mjs --corpus"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/material": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@angular/service-worker": "^22.1.3",
    "@capacitor-firebase/authentication": "8.4.0",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "8.5.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/status-bar": "8.0.3",
    "@popperjs/core": "^2.11.8",
    "apexcharts": "^6.10.0",
    "bootstrap": "^5.3.8",
    "firebase": "^12.17.1",
    "jwt-decode": "^4.0.0",
    "material-icons": "^1.13.14",
    "ng-apexcharts": "^2.5.0",
    "ngx-dropzone": "^3.1.0",
    "rxjs": "~7.8.2",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@angular/localize": "^22.1.3",
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "^1.62.1",
    "@redocly/cli": "^2.46.2",
    "@types/jasmine": "~5.1.0",
    "esbuild": "^0.28.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "11.1.1",
    "qs": "6.16.0"
  }
}
