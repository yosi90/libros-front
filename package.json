{
  "name": "book-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:qa": "ng build --configuration=qa",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage --no-progress",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:typecheck": "tsc --project tsconfig.e2e.json",
    "api:lint": "redocly lint --extends=minimal docs/backend/openapi.yaml",
    "qa:control:test": "node --test scripts/qa/*.test.mjs",
    "qa:ci": "npm run api:lint && npm run qa:control:test && npm run build && npm run test:ci && npm run e2e:typecheck && playwright test --project=chromium --grep @smoke",
    "qa:integration": "playwright test --config=playwright.integration.config.ts --grep @integration",
    "qa:visual": "playwright test --project=chromium --grep @visual"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.4",
    "@angular/cdk": "^19.2.7",
    "@angular/common": "^19.2.4",
    "@angular/compiler": "^19.2.4",
    "@angular/core": "^19.2.4",
    "@angular/forms": "^19.2.4",
    "@angular/material": "^19.2.7",
    "@angular/platform-browser": "^19.2.4",
    "@angular/platform-browser-dynamic": "^19.2.4",
    "@angular/router": "^19.2.4",
    "@popperjs/core": "^2.11.8",
    "apexcharts": "^4.5.0",
    "book-front": "file:",
    "bootstrap": "^5.3.2",
    "firebase": "^12.16.0",
    "jwt-decode": "^4.0.0",
    "ng-apexcharts": "^1.15.0",
    "ngx-dropzone": "^3.1.0",
    "rxjs": "~7.8.2",
    "sweetalert2": "^11.6.13",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.5",
    "@angular/cli": "^19.2.5",
    "@angular/compiler-cli": "^19.2.4",
    "@angular/localize": "^19.2.4",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@redocly/cli": "^2.46.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.2"
  }
}
