{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "book-front": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "sass"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/book-front",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "sass",
            "assets": [
              "src/favicon.ico",
              "src/manifest.webmanifest",
              "src/assets"
            ],
            "styles": [
              "node_modules/material-icons/iconfont/filled.css",
              "src/styles.sass"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "assets": [
                "src/favicon.ico",
                "src/manifest.webmanifest",
                "src/assets",
                { "glob": "assetlinks.json", "input": "src/hosting/production/.well-known", "output": "/.well-known" }
              ],
              "serviceWorker": "ngsw-config.json",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2100kb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "40kb",
                  "maximumError": "80kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "qa": {
              "assets": [
                "src/favicon.ico",
                "src/manifest.webmanifest",
                "src/assets",
                { "glob": "assetlinks.json", "input": "src/hosting/qa/.well-known", "output": "/.well-known" }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environment/environment.ts",
                  "with": "src/environment/environment.qa.ts"
                }
              ],
              "optimization": true,
              "extractLicenses": true,
              "sourceMap": true,
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "dev-plataforma": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environment/environment.ts",
                  "with": "src/environment/environment.dev-plataforma.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "book-front:build:production"
            },
            "development": {
              "buildTarget": "book-front:build:development"
            },
            "qa": {
              "buildTarget": "book-front:build:qa"
            },
            "dev-plataforma": {
              "buildTarget": "book-front:build:dev-plataforma",
              "host": "127.0.0.15",
              "port": 443,
              "ssl": true,
              "proxyConfig": "proxy.dev-plataforma.json",
              "allowedHosts": [
                "libros.dev.yosiftware.es"
              ],
              "headers": {
                "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://qa-cuentas.yosiftware.es https://estadisticas.yosiftware.es; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://qa-cuentas-api.yosiftware.es https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://qa-cuentas-api.yosiftware.es wss://qa-cuentas-ws.yosiftware.es https://estadisticas.yosiftware.es; frame-src https://qa-cuentas.yosiftware.es; worker-src 'self' blob:; manifest-src 'self'",
                "Cross-Origin-Opener-Policy": "same-origin-allow-popups"
              }
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "book-front:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "sass",
            "assets": [
              "src/favicon.ico",
              "src/manifest.webmanifest",
              "src/assets"
            ],
            "styles": [
              "node_modules/material-icons/iconfont/filled.css",
              "src/styles.sass"
            ],
            "scripts": [],
            "karmaConfig": "karma.conf.js"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
